diff -ruN avant/src/lib/Dao.class.php apres/src/lib/Dao.class.php
--- avant/src/lib/Dao.class.php	2026-10-23 16:12:48.883600206 +0200
+++ apres/src/lib/Dao.class.php	2026-10-23 16:27:01.196267921 +0200
@@ -109,16 +109,28 @@
 
     /**
      * Désérialise une liste transmise dans l'URL (salles, jours ouvrés) sans instancier d'objet
-     * et en ne gardant que des entiers ou la valeur vide
+     * et en ne gardant que des entiers, dédupliqués
      */
     public static function unserializeListe($serialise) {
         $liste = is_string($serialise) ? unserialize($serialise, array('allowed_classes' => false)) : $serialise;
         if (!is_array($liste)) {
             return array();
         }
-        return array_map(function ($valeur) {
-            return is_numeric($valeur) ? (string) intval($valeur) : '';
-        }, $liste);
+        // Valeurs invalides retirées (pas blanchies), doublons supprimés.
+        $valeurs = array();
+        foreach ($liste as $valeur) {
+            if (is_numeric($valeur)) {
+                $valeurs[(string) intval($valeur)] = true;
+            }
+        }
+        return array_keys($valeurs);
+    }
+
+    /**
+     * Valide un horaire au format hh:mm avec des bornes calendaires réelles
+     */
+    public static function heureValide($valeur) {
+        return is_string($valeur) && preg_match('/\A(?:[01][0-9]|2[0-3]):[0-5][0-9]\z/', $valeur) === 1;
     }
 
 }
