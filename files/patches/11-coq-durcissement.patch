-$SIG{CHLD} = 'IGNORE';
+# --- Paramètres de durcissement réseau (transparents pour un poussin légitime) ---
+my $MAX_LINE      = 8192;   # taille max d'une ligne : une remontée chiffrée fait quelques dizaines d'octets
+my $READ_TIMEOUT  = 20;     # secondes d'inactivité avant de couper une connexion (anti-slowloris)
+my $MAX_SESSION   = 60;     # durée totale max d'une connexion : une remontée normale prend <1s
+my $MAX_ENFANTS   = 80;     # connexions simultanées max ; configurable via coq.yml (server->max_children)
+my $enfants       = 0;      # nombre d'enfants vivants
+
+# Moissonneur : réduit le compteur à la fin de chaque enfant (remplace l'ancien 'IGNORE')
+$SIG{CHLD} = sub { local ($!, $?); while ((my $p = waitpid(-1, WNOHANG)) > 0) { $enfants-- if $enfants > 0; } };
+
+# Lit une ligne octet par octet, bornée en taille et en durée ; renvoie undef sur EOF,
+# timeout, dépassement de taille ou dépassement de l'échéance absolue $deadline (epoch).
+sub lire_ligne {
+	my ($sock, $max, $deadline) = @_;
+	my $ligne = '';
+	my $c;
+	while (1) {
+		return undef if time() > $deadline;   # échéance de la session dépassée
+		my $n = sysread($sock, $c, 1);
+		return undef if !defined $n;                       # erreur de lecture (hors timeout : cf. SO_RCVTIMEO)
+		if ($n == 0) { return length($ligne) ? $ligne : undef; }   # EOF : on restitue le fragment, comme <$client> à l'origine
+		$ligne .= $c;
+		return $ligne if $c eq "\n";
+		return undef if length($ligne) > $max;
+	}
+}
 
